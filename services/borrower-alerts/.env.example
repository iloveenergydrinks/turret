# Server-side only. Never put these values in NEXT_PUBLIC variables.
ALERTS_APP_ORIGIN=https://turret.capital
ALERTS_RPC_URL=https://rpc.mainnet.chain.robinhood.com
ALERTS_DB_PATH=/data/alerts.sqlite
ALERTS_DATA_KEY=
RESEND_API_KEY=
ALERTS_EMAIL_FROM=Turret <alerts@turret.capital>
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
PORT=3030
# Default stock mode preserves the existing deployment. Isolated markets need
# their own service, database, verified subscriptions and frontend routing.
ALERTS_PROTOCOL=stock
# For ALERTS_PROTOCOL=isolated, all values below are required:
# ALERTS_VAULT_ADDRESS=
# ALERTS_VAULT_CODE_HASH=
# ALERTS_POOL_ADDRESS=
# ALERTS_POOL_CODE_HASH=
# ALERTS_COLLATERAL_ADDRESS=
# ALERTS_COLLATERAL_CODE_HASH=
# ALERTS_START_BLOCK=

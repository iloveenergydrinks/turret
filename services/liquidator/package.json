{
  "name": "dockyard-liquidator",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@8.15.8",
  "engines": { "node": ">=24" },
  "scripts": {
    "start": "node src/main.mjs",
    "start:isolated": "node src/isolated/main.mjs",
    "watchdog": "node src/watchdog.mjs",
    "test": "node --test test/*.test.mjs",
    "test:isolated-integration": "node --test test/isolated.integration.mjs",
    "test:stock-integration": "node --test test/stock-isolated.integration.mjs",
    "test:stock-direct-fork": "node scripts/run-stock-direct-fork.mjs",
    "test:stock-real-worker": "node scripts/run-stock-direct-fork.mjs --worker",
    "test:stock-real-daemon": "node scripts/run-stock-direct-fork.mjs --daemon",
    "test:isolated-real-pools": "node --test test/isolated-real-pools.integration.mjs",
    "test:fork": "node --test test/fork.integration.mjs"
  },
  "dependencies": { "viem": "2.31.4" }
}

FROM node:22-bookworm-slim

WORKDIR /app

RUN corepack enable && corepack prepare pnpm@8.15.8 --activate

COPY . .

ENV NEXT_TELEMETRY_DISABLED=1
ENV NEXT_PUBLIC_MVP_READ_ONLY=true
ENV MVP_READ_ONLY=true

RUN pnpm install --frozen-lockfile
RUN pnpm --dir frontend/app build:mvp

EXPOSE 3000

CMD ["node", "frontend/app/scripts/serve-mvp.mjs"]

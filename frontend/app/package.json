{
  "name": "@turret/app",
  "private": true,
  "author": "Turret contributors",
  "license": "MIT",
  "version": "1.11.0",
  "type": "module",
  "scripts": {
    "build": "pnpm build-deps && pnpm clean && next build && node scripts/verify-borrowing-video.mjs && node scripts/apply-social-metadata.mjs && node scripts/check-design-notes.mjs",
    "build:mvp": "pnpm build-uikit && pnpm build-banner && pnpm build-panda && next build && node scripts/verify-borrowing-video.mjs && node scripts/apply-social-metadata.mjs && node scripts/check-design-notes.mjs",
    "build-analyze": "ANALYZE=true pnpm build",
    "build-banner": "test -f ./Banner.tsx || cp ./Banner.example.tsx ./Banner.tsx",
    "build-deps": "pnpm build-graphql && pnpm build-uikit && pnpm build-banner && pnpm build-panda",
    "build-graphql": "pnpm graphql-codegen --config graphql-codegen.ts",
    "build-panda": "panda codegen --silent",
    "build-uikit": "cd ../uikit && pnpm build",
    "clean": "rm -rf ./.next",
    "coverage": "vitest run --coverage ./src",
    "dev": "pnpm clean && next dev --turbopack",
    "fmt": "dprint fmt **/*.{ts,tsx,js,json,html,md}",
    "lint": "pnpm oxlint ./src",
    "test": "vitest",
    "test:unit": "vitest run",
    "test:server": "node --test scripts/blog-routing.test.mjs scripts/byte-range.test.mjs scripts/rpc-proxy.test.mjs scripts/p2p-loan-index.test.mjs scripts/p2p-requests.test.mjs scripts/p2p-alerts-proxy.test.mjs",
    "test:p2p-integration": "node --test scripts/p2p-requests.integration.test.mjs && vitest run src/p2p/activity.integration.test.ts",
    "p2p:health": "node scripts/p2p-health.mjs",
    "test:rpc-browser": "node --test scripts/rpc-browser.test.mjs",
    "test:release-smoke": "node --test scripts/stock-release-smoke.mjs",
    "test:all": "pnpm test:unit && pnpm test:server && pnpm test:isolated-integration",
    "test:isolated-integration": "tsx --test scripts/isolated-credit.integration.ts",
    "update-liquity-abis": "pnpm exec tsx ./scripts/update-liquity-abis.ts",
    "test:video-release": "node scripts/verify-borrowing-video.mjs",
    "test:social-sharing": "node --test scripts/apply-social-metadata.test.mjs",
    "test:release-design-notes": "node --test scripts/check-design-notes.test.mjs",
    "check:release-design-notes": "node scripts/check-design-notes.mjs"
  },
  "dependencies": {
    "@fontsource-variable/figtree": "^5.3.0",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@turret/uikit": "workspace:*",
    "@next/bundle-analyzer": "15.3.8",
    "@paper-design/shaders-react": "0.0.80",
    "@react-spring/web": "^10.0.1",
    "@tanstack/react-query": "^5.81.2",
    "@vercel/analytics": "^1.5.0",
    "@wagmi/core": "^2.17.3",
    "abitype": "^1.0.8",
    "blo": "^2.0.0",
    "connectkit": "^1.9.1",
    "dnum": "^2.15.0",
    "focus-trap-react": "^11.0.4",
    "geist": "^1.4.2",
    "gray-matter": "4.0.3",
    "marked": "15.0.12",
    "next": "15.3.8",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "sharp": "^0.34.2",
    "three": "0.180.0",
    "ts-pattern": "^5.7.1",
    "valibot": "^1.1.0",
    "viem": "^2.31.4",
    "wagmi": "^2.15.6"
  },
  "devDependencies": {
    "@babel/plugin-transform-private-methods": "^7.27.1",
    "@graphql-codegen/cli": "^5.0.7",
    "@graphql-codegen/schema-ast": "^4.1.0",
    "@next/env": "^15.5.2",
    "@pandacss/dev": "^0.54.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.0.4",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "@types/three": "0.180.0",
    "@typescript-eslint/parser": "^8.41.0",
    "@vitejs/plugin-react": "^4.6.0",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.29.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jsdom": "^26.1.0",
    "oxlint": "^1.3.0",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4",
    "zx": "^8.6.0"
  }
}
